---
import printingImage from "../assets/printing.png";
import requestImage from "../assets/request.png";
import adjustrepairImage from "../assets/adjustrepair.png";
import donateImage from "../assets/donate.png";
import volunteerImage from "../assets/volunteer.png";
import fittingImage from "../assets/fitting.png";
import Card from "./Card.astro";

const services = [
  {
    title: "3D Hand Printing",
    summary: "",
    image: printingImage,
    link: "/services#professional-healthcare-services",
  },
  {
    title: "Fitting",
    summary: "",
    image: fittingImage,
    link: "/services#our-staff",
  },  
  {
    title: "Request a 3D Hand",
    summary: "",
    image: requestImage,
    link: "/services#our-patient-care",
  },
  {
    title: "Request Adjustment/Repair",
    summary: "",
    image: adjustrepairImage,
    link: "/services#our-staff",
  },
  {
    title: "Donate",
    summary: "",
    image: donateImage,
    link: "https://opencollective.com/open-source-prosthetics",
  },
  {
    title: "Volunteer",
    summary: "",
    image: volunteerImage,
    link: "/services#our-staff",
  },    
];
---

<div class="container">
  <div class="text-center mb-12">
    <p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
      What We Do
    </p>
    <h2>Our Services</h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {
      services.map((service) => (
        <Card
          title={service.title}
          summary={service.summary}
          image={service.image}
          link={service.link}
        />
      ))
    }
  </div>
</div>
