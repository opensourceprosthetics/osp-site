---
import Layout from "../layouts/Layout.astro";

import professionalPortraitImage from "../assets/illustrated-graphics-03.png";
import { Image } from "astro:assets";
import serviceDetailImage from "../assets/illustrated-graphics-03.png";
import heroServicesImage from "../assets/illustrated-graphics-08.png";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Icon from "../components/Icon.astro";
import CheckListItem from "../components/CheckListItem.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Heading from "../components/Heading.astro";
---

<Layout
  title="Open Source Prosthetics"
  description="Comprehensive healthcare services including chronic care management, post-surgical care, respiratory therapy, and specialized support. Expert care in the comfort of your home."
>
  <!-- Hero Section -->
  <PageHero
    title="WHAT WE DO"
    description=""
    image={heroServicesImage}
  />

  <!-- Mission Statement -->
  <section
    class="section bg-gradient-to-b from-theme-surface to-theme-surface-muted"
  >
    <div class="container">
      <div class="narrow mx-auto text-center space-y-6">
        <Heading level="h2" align="center"> Our Mission </Heading>
        <p class="text-lg lg:text-xl text-theme-text-secondary leading-relaxed">
          It is commonly accepted that the potential for patient progress and
          recovery are substantially improved when patients are surrounded by
          their native environment. Viva Medical passionately vows to
          provide quality healthcare services to a broad spectrum of patients
          within our expertise, experience and service skills.
        </p>
        <p
          class="text-base lg:text-lg text-theme-text-secondary leading-relaxed"
        >
          Our compassionate, dedicated services are provided with dignity and
          respect, available to individuals of all ages regardless of race,
          color, sex, national origin, religion, age or disability.
        </p>
      </div>
    </div>
  </section>

  <!-- Specialized Healthcare Services -->
  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
  >
    <div class="container">
      <div class="narrow mx-auto text-center mb-12">
        <Heading level="h2" align="center" class="mb-4">
          Specialized Healthcare Services
        </Heading>
        <p class="text-base lg:text-lg text-theme-text-secondary">
          Our highly trained professionals provide expert care for a
          comprehensive range of healthcare services
        </p>
      </div>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-8 lg:gap-12 max-w-7xl mx-auto"
      >
        <ServiceCard title="Printing" />
        <ServiceCard title="Adjustment and Repair" />
        <ServiceCard title="Volunteer" />
        <ServiceCard title="Fitting" />
        <ServiceCard title="Donate" />
        <ServiceCard title="Request" />
      </div>
    </div>
  </section>

  <!-- Patient Care Approach -->
  <section class="section bg-theme-surface">
    <div class="container">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16"
      >
        <div class="w-full order-2 lg:order-1">
          <Image
            src={professionalPortraitImage}
            alt="Professional healthcare provider"
            class="w-full object-cover rounded-2xl shadow-xl"
          />
        </div>
        <div class="space-y-6 order-1 lg:order-2">
          <Heading level="h2"> Our Patient Care Approach </Heading>
          <p
            class="text-base lg:text-lg text-theme-text-secondary leading-relaxed"
          >
            Dedication and service are at the core of our organization. We
            incorporate compassion and empathy in conducting patient information
            gathering, assessment, planning, intervention, evaluation and
            education.
          </p>
          <div class="space-y-4">
            <h4 class="text-lg font-semibold text-theme-text-primary">
              Our agency manages and coordinates:
            </h4>
            <ul class="space-y-3">
              <CheckListItem
                >Patient intake and nursing assignments</CheckListItem
              >
              <CheckListItem>Treatment and therapy verification</CheckListItem>
              <CheckListItem>Therapy scheduling</CheckListItem>
              <CheckListItem
                >Confirming the physician's plan of treatment (POT)</CheckListItem
              >
              <CheckListItem>Documenting patient status</CheckListItem>
              <CheckListItem>Providing progress reports</CheckListItem>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Professional Staff -->
  <section
    class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
  >
    <div class="container">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16"
      >
        <div class="space-y-6">
          <Heading level="h2"> Our Professional Staff </Heading>
          <p
            class="text-base lg:text-lg text-theme-text-secondary leading-relaxed"
          >
            Healthcare coordinators can rely upon our family of qualified
            professionals to service their patient base, ensuring an optimal and
            timely response to implementing medical treatment regimes.
          </p>
          <div
            class="bg-theme-surface rounded-xl p-6 lg:p-8 shadow-md border border-theme-border"
          >
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <Icon
                  name="check"
                  size="md"
                  class="text-theme-primary flex-shrink-0 mt-1"
                />
                <div>
                  <h4 class="font-semibold text-theme-text-primary mb-1">
                    Licensed Professionals
                  </h4>
                  <p class="text-theme-text-secondary">
                    All healthcare providers are licensed in the states they
                    service
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon
                  name="check"
                  size="md"
                  class="text-theme-primary flex-shrink-0 mt-1"
                />
                <div>
                  <h4 class="font-semibold text-theme-text-primary mb-1">
                    Multi-State Coverage
                  </h4>
                  <p class="text-theme-text-secondary">
                    Many professionals possess licensure in multiple states
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon
                  name="check"
                  size="md"
                  class="text-theme-primary flex-shrink-0 mt-1"
                />
                <div>
                  <h4 class="font-semibold text-theme-text-primary mb-1">
                    Ongoing Education
                  </h4>
                  <p class="text-theme-text-secondary">
                    Continuous professional development and training
                    opportunities
                  </p>
                </div>
              </div>
            </div>
          </div>
          <p
            class="text-base lg:text-lg text-theme-text-secondary leading-relaxed"
          >
            Viva Medical works in tandem with our healthcare professionals
            and contracted partners to initiate a seamless process for the most
            effective quality patient care.
          </p>
        </div>
        <div class="w-full">
          <Image
            src={serviceDetailImage}
            alt="Healthcare team coordination"
            class="w-full object-cover rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>


  <CallToActionSection
    heading="Ready for Professional Healthcare Services?"
    subheading="Our expert healthcare team serves the regional area including multiple states and communities. Let us bring professional healthcare directly to your home."
    primaryButtonText="Schedule a Consultation"
    primaryButtonLink="/contact"
    secondaryButtonText="Join Our Healthcare Team"
    secondaryButtonLink="/careers"
  />
</Layout>
