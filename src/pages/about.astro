---
import Layout from "../layouts/Layout.astro";
import aboutHeroImage from "../assets/graphics/illustrated-graphics-07.png";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import founderImage from "../assets/icons/founder.png";
import engineerImage from "../assets/icons/engineer.png";
import prosthetistImage from "../assets/icons/prosthetist.png";
import { Image } from "astro:assets";
import Heading from "../components/Heading.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="About Us"
  description=""
>
  <PageHero
      title="WHY WE DO WHAT WE DO"
      description=""
      image={aboutHeroImage}
    />

      <!-- Mission Statement -->
    <section
      class="section bg-gradient-to-b from-theme-surface to-theme-surface-muted"
    >
      <div class="container">
        <div class="narrow mx-auto text-center space-y-6">
          <Heading level="h2" align="center"> Our Mission </Heading>
          <p class="text-lg lg:text-xl text-theme-text-secondary leading-relaxed">
            To help those who were born missing their fingers and hands or who have lost them due to war, natural disaster, illness or accidents.
          </p>
          <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
            Our compassionate, dedicated services are provided with dignity and
            respect, available to individuals of all ages regardless of race,
            color, sex, national origin, religion, age or disability.
          </p>
        </div>
      </div>
    </section>

    <section class="section bg-gradient-to-b from-theme-primary-lighter/20 via-theme-primary-lighter/10 to-theme-surface">
      <div class="container">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-theme-text-primary mb-4">
            Meet Our Team
          </h2>
          <p class="text-lg text-theme-text-secondary max-w-3xl mx-auto">
            Dedicated professionals committed to delivering exceptional
            healthcare services
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 mx-auto">
          {/* Founder 1 */}
          <div class="w-full">
            <div class="bg-theme-surface rounded-2xl overflow-hidden transition-all duration-300">
              <div class="relative h-80 lg:h-96 overflow-hidden">
                <Image
                  src={founderImage}
                  alt="David Thompson"
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent">
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <h2 class="text-2xl lg:text-3xl font-bold mb-2 text-theme-text-primary">
                  Daniel Beukes
                </h2>
                <p class="text-base text-theme-primary font-semibold mb-6">
                  Founder & Director
                </p>
                <div
                  id="davidText"
                  class="text-theme-text-secondary text-base lg:text-lg leading-relaxed overflow-hidden transition-all duration-300 max-h-[200px]">
                </div>
                <button
                  class="toggle-btn mt-4 inline-flex items-center text-theme-primary hover:text-theme-primary-dark font-semibold transition-colors group"
                  data-target="davidText"
                  aria-expanded="false"
                >
                  <span>Read more</span>
                  <Icon
                    name="chevron-down"
                    size="sm"
                    class="ml-2 group-hover:translate-y-0.5 transition-transform duration-300"
                  />
                </button>
              </div>
            </div>
          </div>
            {/* Founder 1 */}
          <div class="w-full">
            <div class="bg-theme-surface rounded-2xl overflow-hidden transition-all duration-300">
              <div class="relative h-80 lg:h-96 overflow-hidden">
                <Image
                  src={engineerImage}
                  alt="David Thompson"
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent">
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <h2 class="text-2xl lg:text-3xl font-bold mb-2 text-theme-text-primary">
                  Engineer
                </h2>
                <p class="text-base text-theme-primary font-semibold mb-6">
                  Engineering & Design
                </p>
                <div
                  id="davidText"
                  class="text-theme-text-secondary text-base lg:text-lg leading-relaxed overflow-hidden transition-all duration-300 max-h-[200px]">
                </div>
                <button
                  class="toggle-btn mt-4 inline-flex items-center text-theme-primary hover:text-theme-primary-dark font-semibold transition-colors group"
                  data-target="davidText"
                  aria-expanded="false"
                >
                  <span>Read more</span>
                  <Icon
                    name="chevron-down"
                    size="sm"
                    class="ml-2 group-hover:translate-y-0.5 transition-transform duration-300"
                  />
                </button>
              </div>
            </div>
          </div>

          {/* Founder 2 */}
          <div class="w-full">
            <div class="bg-theme-surface rounded-2xl overflow-hidden transition-all duration-300">
              <div class="relative h-80 lg:h-96 overflow-hidden">
                <Image
                  src={prosthetistImage}
                  alt="Jennifer Martinez"
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent">
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <h2
                  class="text-2xl lg:text-3xl font-bold mb-2 text-theme-text-primary">
                  Prothetist
                </h2>
                <p class="text-base text-theme-primary font-semibold mb-6">
                  Medical & Fitting
                </p>
                <div
                  id="jenniferText"
                  class="text-theme-text-secondary text-base lg:text-lg leading-relaxed overflow-hidden transition-all duration-300 max-h-[200px]">
                  
          </div>        
                <button
                  class="toggle-btn mt-4 inline-flex items-center text-theme-primary hover:text-theme-primary-dark font-semibold transition-colors group"
                  data-target="jenniferText"
                  aria-expanded="false"
                >
                  <span>Read more</span>
                  <Icon
                    name="chevron-down"
                    size="sm"
                    class="ml-2 group-hover:translate-y-0.5 transition-transform duration-300"
                  />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

    </section>

    <CallToActionSection
      heading="Partner With Our Experienced Team"
      subheading="Discover how our 15+ years of dedication to excellence can benefit your healthcare journey. We're here to provide compassionate, professional care when you need it most."
      primaryButtonText="Contact Our Team"
      primaryButtonLink="/contact"
      secondaryButtonText="View Our Services"
      secondaryButtonLink="/services"
    />
</Layout>

<script>
  function initToggleButtons() {
    document.querySelectorAll(".toggle-btn").forEach((button) => {
      const btn = button as HTMLButtonElement;
      
      // Prevent duplicate event listeners
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const textContainer = document.getElementById(targetId);
        if (!textContainer) return;

        const buttonText = btn.querySelector("span");
        const buttonIcon = btn.querySelector("svg");
        const isExpanded = btn.getAttribute("aria-expanded") === "true";

        if (isExpanded) {
          textContainer.classList.remove("max-h-full");
          textContainer.classList.add("max-h-[200px]");
          if (buttonText) buttonText.textContent = "Read more";
          if (buttonIcon) buttonIcon.style.transform = "rotate(0deg)";
          btn.setAttribute("aria-expanded", "false");
        } else {
          textContainer.classList.remove("max-h-[200px]");
          textContainer.classList.add("max-h-full");
          if (buttonText) buttonText.textContent = "Read less";
          if (buttonIcon) buttonIcon.style.transform = "rotate(180deg)";
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  // Astro best practice with ClientRouter: re-run on astro:page-load
  document.addEventListener("astro:page-load", initToggleButtons);
</script>
